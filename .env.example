# ============================================
# FRONTEND ENVIRONMENT VARIABLES (Next.js)
# ============================================

# Supabase Configuration (Required for Auth & Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API URL (Required - Point to your deployed FastAPI backend)
NEXT_PUBLIC_BACKEND_URL=https://your-backend.railway.app
# For local development: http://127.0.0.1:8001

# App Configuration
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NODE_ENV=production

# Sentry Configuration (Optional - for error tracking)
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
SENTRY_SUPPRESS_INSTRUMENTATION_FILE_WARNING=1
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# ============================================
# BACKEND ENVIRONMENT VARIABLES (FastAPI)
# These should be set in your backend deployment (Railway/Render)
# ============================================

# AI Service API Keys
GROQ_API_KEY=your_groq_api_key_here
HUGGING_FACE_API_TOKEN=your_huggingface_token_here
STABILITY_API_KEY=your_stability_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Image Provider API Keys
PEXELS_API_KEY=your_pexels_api_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# Geolocation & Places API
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Vastu & Astrology Services
ASTROLOGY_API_KEY=your_astrology_api_key_here

# MCP Server (Optional - for Tavily integration)
TAVILY_API_KEY=your_tavily_api_key_here
MCP_SERVER_URL=http://localhost:3001

# ============================================
# NOTES
# ============================================
# 1. Never commit actual API keys to git
# 2. Set these in Vercel Dashboard → Settings → Environment Variables
# 3. Set backend variables in Railway/Render dashboard
# 4. NEXT_PUBLIC_* variables are exposed to the browser
# 5. Non-NEXT_PUBLIC_* variables are server-side only
